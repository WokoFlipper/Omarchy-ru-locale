#!/usr/bin/env python3
"""Translate Omarchy Hyprland keybinding descriptions into Russian.

Default binds live in the omarchy package and are overwritten on update,
so user overrides must live in ~/.config/hypr/bindings.lua. This script
regenerates a marked block there: for every default o.bind()/o.bind_toggle()
whose description has a Russian entry in translations/bindings-ru.tsv it
emits hl.unbind() + o.bind() with the Russian description and the original
dispatcher copied verbatim (multi-line calls supported).

Keys the user already unbound or rebound outside the block are skipped, so
personal overrides (e.g. code: binds covering EN+RU layouts) always win.

Letter binds additionally get a code: duplicate (same description and
dispatcher): Hyprland matches keysyms, so under a Cyrillic layout the Latin
bind never fires. X11 keycodes are layout-independent, and Omarchy's hl.bind
passes code:NN through (stock tiling.lua already relies on it). C/V/X are
excluded (live-tested 2026-09-21: code: dups break copy/paste/cut).
Symbol finals SLASH/comma are duplicated too (different keys in RU);
digits, special keys, XF86 and mouse binds are layout-independent already.
Clipboard copy/paste/cut (SUPER+C/V/X) are NOT translated: live-tested
2026-09-21, any override (code: dups included) breaks copy/paste/cut,
so stock binds stay untouched.

Usage: bindings-translate status
       bindings-translate apply ru_RU
       bindings-translate remove
"""

import glob
import os
import re
import shutil
import subprocess
import sys

OMARCHY = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
DEFAULT_HYPR = os.path.join(OMARCHY, "default", "hypr")
USER_BINDS = os.path.join(os.environ["HOME"], ".config", "hypr", "bindings.lua")
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
TABLE = os.path.join(SCRIPT_DIR, "translations", "bindings-ru.tsv")

BEGIN = "-- >>> locale-ru-bindings begin"
END = "-- <<< locale-ru-bindings end"

# Descriptions passed as window match strings (helpers.lua o.launch_webapp_sole
# -> omarchy-launch-or-focus-webapp <name> <url>). Translating these changes
# BEHAVIOUR (which window gets focused), not display. Never emit them until
# linyiru's opts.id branch lands (omacom/omarchy#12404).
# See WEBAPP-BIND-AUDIT.md.
DANGEROUS_DESCS = frozenset({
    "WhatsApp",
    "Google Messages",
    "Google Photos",
    "Google Maps",
})


def fail(msg):
    print(f"bindings-translate: {msg}", file=sys.stderr)
    sys.exit(1)


def load_table(path):
    table = {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line or line.startswith("#") or "\t" not in line:
                continue
            en, ru = line.split("\t", 1)
            if ru:
                table[en] = ru
    return table


def parse_lua_string(src, i):
    """Parse a double-quoted Lua string starting at src[i]=='"'. Returns (value, end_index)."""
    assert src[i] == '"'
    i += 1
    out = []
    while i < len(src):
        c = src[i]
        if c == "\\" and i + 1 < len(src):
            out.append(c)
            out.append(src[i + 1])
            i += 2
            continue
        if c == '"':
            return "".join(out), i + 1
        out.append(c)
        i += 1
    fail("unterminated string literal while parsing default binds")


def skip_balanced(src, i):
    """Skip from just after 'o.bind(' to its matching close paren. Returns end index."""
    depth = 1
    instr = False
    esc = False
    while depth and i < len(src):
        c = src[i]
        if instr:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                instr = False
        else:
            if c == '"':
                instr = True
            elif c == "(":
                depth += 1
            elif c == ")":
                depth -= 1
        i += 1
    return i


def find_calls(src):
    """Yield (keys, desc, dispatcher_src) for o.bind()/o.bind_toggle() calls."""
    for m in re.finditer(r"o\.bind(_toggle)?\(", src):
        i = m.end()
        while i < len(src) and src[i] in " \t\n":
            i += 1
        if i >= len(src) or src[i] != '"':
            continue  # dynamic keys (e.g. built in a loop) — skip
        keys, i = parse_lua_string(src, i)
        while i < len(src) and (src[i] in " \t\n" or src[i] == ","):
            i += 1
        if i >= len(src) or src[i] != '"':
            continue  # no string description (e.g. nil) — nothing to translate
        desc, i = parse_lua_string(src, i)
        while i < len(src) and (src[i] in " \t\n" or src[i] == ","):
            i += 1
        # dispatcher: everything up to the matching close paren
        start = i
        depth = 1
        instr = False
        esc = False
        while depth and i < len(src):
            c = src[i]
            if instr:
                if esc:
                    esc = False
                elif c == "\\":
                    esc = True
                elif c == '"':
                    instr = False
            else:
                if c == '"':
                    instr = True
                elif c == "(":
                    depth += 1
                elif c == ")":
                    depth -= 1
            i += 1
        yield keys, desc, src[start : i - 1].strip()


def collect_defaults():
    calls = []
    for path in sorted(glob.glob(os.path.join(DEFAULT_HYPR, "**", "*.lua"), recursive=True)):
        with open(path, encoding="utf-8") as fh:
            src = fh.read()
        # file-local helpers are out of scope in the user file: a copied
        # dispatcher calling one would fail with "attempt to call a nil value"
        locals_ = set(re.findall(r"local\s+function\s+(\w+)", src))
        locals_.update(re.findall(r"local\s+(\w+)\s*=\s*function", src))
        for keys, desc, disp in find_calls(src):
            if any(re.search(r"\b" + re.escape(name) + r"\b", disp) for name in locals_):
                continue
            calls.append((keys, desc, disp))
    # dedupe by (keys, desc), keep first
    seen = set()
    uniq = []
    for keys, desc, disp in calls:
        if (keys, desc) not in seen:
            seen.add((keys, desc))
            uniq.append((keys, desc, disp))
    return uniq


def lua_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def user_managed_keys(body):
    """Keys the user unbound or bound outside our block — never touch those."""
    # strip full-line comments first: commented examples must not count
    code = "\n".join(
        line for line in body.split("\n") if not line.strip().startswith("--")
    )
    keys = set()
    for m in re.finditer(r'hl\.unbind\(\s*"((?:[^"\\]|\\.)*)"\s*\)', code):
        keys.add(m.group(1))
    for m in re.finditer(r'o\.bind(?:_toggle)?\(\s*"((?:[^"\\]|\\.)*)"', code):
        keys.add(m.group(1))
    return keys


def split_user_file():
    if not os.path.exists(USER_BINDS):
        return ""
    with open(USER_BINDS, encoding="utf-8") as fh:
        content = fh.read()
    if BEGIN in content and END not in content:
        fail("user file has a BEGIN marker without END — refusing to touch it, fix manually")
    lines = content.split("\n")
    out = []
    skipping = False
    for line in lines:
        if line.strip().startswith(BEGIN):
            skipping = True
            continue
        if line.strip().startswith(END):
            skipping = False
            continue
        if not skipping:
            out.append(line)
    body = "\n".join(out).rstrip("\n") + "\n" if out else ""
    # Truncation tripwire (2026-09-21 incident): markers present but the
    # surviving user content is implausibly small next to the raw file.
    # Never return a near-empty body in that case — fail loudly instead.
    if BEGIN in content:
        raw_n = len([l for l in lines if l.strip() and not l.strip().startswith("--")])
        body_n = len([l for l in body.split("\n") if l.strip() and not l.strip().startswith("--")])
        if raw_n > 50 and body_n < 5:
            fail(f"split_user_file would drop user content ({raw_n} -> {body_n} lines) — refusing, fix manually")
    return body


# X11 keycodes for single-key finals that move between EN/RU layouts.
# Letters: standard X11 set (evdev + 8). SLASH/COMMA: different keys in RU.
# C/V/X excluded from auto-duplication (clipboard fragility, see below).
X11_CODES = {
    "Q": 24, "W": 25, "E": 26, "R": 27, "T": 28, "Y": 29, "U": 30,
    "I": 31, "O": 32, "P": 33, "A": 38, "S": 39, "D": 40, "F": 41,
    "G": 42, "H": 43, "J": 44, "K": 45, "L": 46, "Z": 52, "X": 53,
    "C": 54, "V": 55, "B": 56, "N": 57, "M": 58,
    "SLASH": 61, "COMMA": 59,
}
# C/V/X EXCLUDED from auto-duplication (2026-09-21 live test: code: dups
# break copy/paste/cut — reverted; clipboard must behave exactly tested).
NO_DUP_FINALS = {"C", "V", "X"}


def collect_clipboard():
    """Clipboard binds + their file-local helpers, namespaced for our block.

    Stock clipboard.lua defines its dispatchers via file-local Lua functions,
    so a verbatim-copied call would die with "attempt to call a nil value" in
    the user file. We extract the helpers fresh from stock at apply time and
    re-emit them under ru_ names (zero interaction with stock internals).
    Returns (helper_src, [(keys, desc, disp), ...]).
    """
    path = os.path.join(DEFAULT_HYPR, "bindings", "clipboard.lua")
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return "", []
    try:
        start = next(i for i, l in enumerate(lines)
                     if l.startswith("local function send_shortcut_once"))
        stop = next(i for i, l in enumerate(lines) if l.startswith("o.bind("))
    except StopIteration:
        fail("clipboard.lua shape changed — refusing to emit clipboard binds")
    helpers = "\n".join(lines[start:stop]).rstrip()
    renames = {
        "send_shortcut_once": "ru_send_shortcut_once",
        "active_window_is_terminal": "ru_active_window_is_terminal",
        "universal_clipboard_shortcut": "ru_universal_clipboard_shortcut",
    }

    def ns(s):
        for old, new in renames.items():
            s = re.sub(r"\b" + re.escape(old) + r"\b", new, s)
        return s

    helpers = ns(helpers)
    calls = [(keys, desc, ns(disp))
             for keys, desc, disp in find_calls("\n".join(lines[stop:]))]
    return helpers, calls


def build_block(table):
    rows = []
    n_binds = 0
    user_body = split_user_file()
    protected = user_managed_keys(user_body)

    def emit(keys, ru, disp):
        nonlocal n_binds
        if keys in protected:
            return
        rows.append(f'hl.unbind({lua_quote(keys)})')
        rows.append(f'o.bind({lua_quote(keys)}, {lua_quote(ru)}, {disp})')
        n_binds += 1

    def emit_layout_dup(keys, ru, disp):
        """Duplicate a letter/symbol bind via X11 keycode (layout-independent).

        Only the final key token is swapped; modifiers stay identical.
        Skipped when the user already manages either spelling.
        """
        parts = [p.strip() for p in keys.split("+")]
        if len(parts) < 2:
            return
        mods, last = parts[:-1], parts[-1]
        code = X11_CODES.get(last.upper(), None) if len(last) == 1 else None
        if last.upper() in ("SLASH", "COMMA"):
            code = X11_CODES[last.upper()]
        if code is None:
            return
        dup = " + ".join(mods + [f"code:{code}"])
        emit(dup, ru, disp)

    for keys, desc, disp in collect_defaults():
        if desc in DANGEROUS_DESCS:
            print(f"bindings-translate: SKIPPING window-matcher bind {desc!r} "
                  f"({keys}) — see WEBAPP-BIND-AUDIT.md", file=sys.stderr)
            continue
        ru = table.get(desc)
        if not ru or ru == desc:
            continue
        emit(keys, ru, disp)
        final = keys.split("+")[-1].strip().upper()
        if final not in NO_DUP_FINALS:
            emit_layout_dup(keys, ru, disp)

    # Universal clipboard binds (SUPER+C/V/X + manager): stock defines their
    # dispatchers via file-local helpers, so plain verbatim copy would crash.
    # Helpers are re-emitted above under ru_ names (fresh from stock).
    helpers, clip_calls = collect_clipboard()
    # Only helper-based binds live here (copy/paste/cut); plain ones like the
    # Clipboard manager already flow through the main loop (with dups).
    # ARCHIVE NOTE: translations/bindings-ru.tsv keeps the FULL translation
    # (Universal copy/cut/paste rows included) as an archive that must NOT be
    # applied — live-tested 2026-09-21, any C/V/X override breaks copy/paste.
    # These three keys stay stock, always.
    CLIP_SKIP = {"SUPER + C", "SUPER + V", "SUPER + X"}
    clip_ru = [(k, d, d2) for k, d, d2 in clip_calls
               if "ru_" in d2 and table.get(d) and table.get(d) != d
               and k not in CLIP_SKIP]
    if clip_ru:
        rows.append("-- Clipboard helpers (namespaced copy of stock clipboard.lua):")
        rows.extend(helpers.split("\n"))
        for keys, desc, disp in clip_ru:
            emit(keys, table[desc], disp)
            final = keys.split("+")[-1].strip().upper()
            if final not in NO_DUP_FINALS:
                emit_layout_dup(keys, table[desc], disp)

    # Workspace loop (tiling.lua): dynamic keys/descs the static parser
    # skips. Keys are code:-based, layout-independent by construction.
    for n in range(1, 11):
        code = n + 9
        emit(f"SUPER + code:{code}", f"Стол {n}",
             f'hl.dsp.focus({{ workspace = "{n}" }})')
        emit(f"SUPER + SHIFT + code:{code}", f"Окно на стол {n}",
             f'hl.dsp.window.move({{ workspace = "{n}" }})')
        emit(f"SUPER + SHIFT + ALT + code:{code}", f"Окно на стол {n} (без фокуса)",
             f'hl.dsp.window.move({{ workspace = "{n}", follow = false }})')

    # Group-window loop (tiling.lua) and bar-panel loop (utilities.lua):
    # same dynamic pattern, same treatment.
    for i in range(1, 6):
        emit(f"SUPER + ALT + code:{i + 9}", f"Окно группы {i}",
             f"hl.dsp.group.active({{ index = {i} }})")
    for p in range(1, 10):
        emit(f"SUPER + CTRL + code:{p + 9}", f"Панель бара {p}",
             f'"omarchy-shell -q shell togglePanelAt right {p}"')

    # C/V/X stay stock (see CLIP_SKIP above): their full Russian translation
    # lives in the table as an archive, never applied.
    header = (
        f"{BEGIN} keys={n_binds}\n"
        "-- Generated by bindings-translate. Edits here are overwritten;\n"
        "-- put your own binds outside this block.\n"
    )
    return header + "\n".join(rows) + f"\n{END}\n", n_binds


def cmd_status():
    state, keys = "off", 0
    if os.path.exists(USER_BINDS):
        with open(USER_BINDS, encoding="utf-8") as fh:
            for line in fh:
                if line.strip().startswith(BEGIN):
                    state = "on"
                    m = re.search(r"keys=(\d+)", line)
                    keys = int(m.group(1)) if m else 0
    avail = []
    if os.path.exists(TABLE):
        avail.append("ru_RU")
    print(f"state={state} keys={keys} available={','.join(avail)}")


def backup():
    import datetime
    if not os.path.exists(USER_BINDS):
        return
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copy2(USER_BINDS, f"{USER_BINDS}.bak.{stamp}")
    shutil.copy2(USER_BINDS, USER_BINDS + ".bak")


def cmd_apply(locale):
    if locale != "ru_RU":
        fail(f"no translation table for {locale}")
    if not os.path.exists(TABLE):
        fail(f"table not found: {TABLE}")
    block, n = build_block(load_table(TABLE))
    body = split_user_file()
    if not body.endswith("\n"):
        body += "\n"
    new_content = body + "\n" + block
    # Subset guard: every non-comment user line must survive into the new file.
    if os.path.exists(USER_BINDS):
        old_user = {l for l in body.split("\n") if l.strip() and not l.strip().startswith("--")}
        new_all = set(new_content.split("\n"))
        lost = old_user - new_all
        if lost:
            fail(f"apply would drop {len(lost)} user lines — aborting, backup kept")
    backup()
    os.makedirs(os.path.dirname(USER_BINDS), exist_ok=True)
    tmp = USER_BINDS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(new_content)
    os.replace(tmp, USER_BINDS)
    print(f"applied {n} translated binds")


def cmd_remove():
    if not os.path.exists(USER_BINDS):
        return
    with open(USER_BINDS, encoding="utf-8") as fh:
        if BEGIN not in fh.read():
            return
    backup()
    with open(USER_BINDS, "w", encoding="utf-8") as fh:
        fh.write(split_user_file())
    print("removed")


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else "status"
    if arg == "status":
        cmd_status()
    elif arg == "apply":
        cmd_apply(sys.argv[2] if len(sys.argv) > 2 else "")
    elif arg == "remove":
        cmd_remove()
    else:
        fail(f"unknown command {arg!r}")
