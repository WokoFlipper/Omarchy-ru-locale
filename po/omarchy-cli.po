msgid "Rebooting"
msgstr "Перезагрузка"

msgid "Shutting down"
msgstr "Выключение"

msgid "Suspending"
msgstr "Режим сна"

msgid "Restarting"
msgstr "Перезагрузка"

msgid "Locking screen"
msgstr "Блокировка экрана"

msgid "Checking for updates"
msgstr "Проверка обновлений"

msgid "Updates available"
msgstr "Доступны обновления"

msgid "Install updates"
msgstr "Установить обновления"

msgid "No updates available"
msgstr "Нет доступных обновлений"

msgid "Fingerprint authentication"
msgstr "Аутентификация по отпечатку"

msgid "Put your finger on the sensor"
msgstr "Положите палец на датчик"

msgid "Add a shell plugin from git"
msgstr "Добавить shell-плагин из git"

msgid "Add branded glyphs to the Omarchy icon font"
msgstr "Добавить брендовые глифы в иконочный шрифт Omarchy"

msgid "Adjust keyboard backlight brightness using available steps"
msgstr "Регулировать подсветку клавиатуры с шагом"

msgid "Adjust output volume and show the Omarchy OSD"
msgstr "Регулировать громкость вывода и показать Omarchy OSD"

msgid "Apply an Omarchy theme"
msgstr "Применить тему Omarchy"


msgid "Launch Files"
msgstr "Открыть файлы"

msgid "Launch a TUI command in the default terminal with Omarchy styling"
msgstr "Запустить TUI-команду в терминале в стиле Omarchy"

msgid "Launch the default coding agent in a terminal"
msgstr "Запустить агент кодинга в терминале"

msgid "Launch the default coding agent with a prompt"
msgstr "Запустить агент кодинга с запросом"

msgid "Launch the default editor selected via Omarchy defaults."
msgstr "Запустить редактор по умолчанию"

msgid "Open the Omarchy background switcher"
msgstr "Сменить обои"

msgid "Open the Omarchy theme switcher"
msgstr "Переключить тему"

msgid "Refresh the shell update status"
msgstr "Проверить статус обновлений"

msgid "Take a screenshot"
msgstr "Сделать скриншот"

msgid "Update Omarchy and system packages"
msgstr "Обновить Omarchy"

msgid "Start or stop screen recording"
msgstr "Начать/остановить запись экрана"

msgid "Shut down after closing application windows"
msgstr "Выключить после закрытия окон"

msgid "Reboot after closing application windows"
msgstr "Перезагрузить после закрытия окон"

msgid "Lock the computer and turn off the display"
msgstr "Заблокировать и выключить экран"

msgid "Close all open windows"
msgstr "Закрыть все окна"

msgid "Switch between audio outputs while preserving the mute status"
msgstr "Переключить аудиовыход (Mute)"

msgid "Set the current background image"
msgstr "Выбрать обои"

msgid "Show current background"
msgstr "Показать текущие обои"

msgid "Show current theme"
msgstr "Показать текущую тему"

msgid "Cycle to the next background for the current theme"
msgstr "Следующие обои темы"

msgid "Launch Signal or start its installer when missing."
msgstr "Запустить Signal"

msgid "Launch Spotify or start its installer when missing."
msgstr "Запустить Spotify"

msgid "Launch 1Password or start its installer when missing."
msgstr "Запустить 1Password"

msgid "Launch the clipboard manager"
msgstr "Открыть менеджер буфера обмена"

msgid "Launch emojis"
msgstr "Открыть эмодзи"

msgid "Insert an emoji into the focused application"
msgstr "Вставить эмодзи"

msgid "Open a clipboard history entry"
msgstr "Открыть запись из истории буфера"

msgid "Copy a file to the clipboard and paste it"
msgstr "Скопировать файл в буфер и вставить"

msgid "Copy text to the clipboard and type or paste it"
msgstr "Скопировать текст в буфер и вставить"

msgid "Send an Omarchy desktop notification"
msgstr "Отправить уведомление"
